<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[globals [ 
  total-fish-harvested 
  total-plants-harvested 
  total-vermaculture-harvested 
  total-crawdads-harvested
  current-toxicity
  current-nutrients
  recent-fish-harvest   
  recent-plant-harvest  
  fish-yield-rate       
  plant-yield-rate      
  current-fish-bio-load 
  current-plant-uptake  
  total-crawdad-weight
  total-fish-weight 
  total-fish-deaths
  total-plant-weight 
  toxicity-spike-timer
]

breed [ nodes node ]
breed [ fishes fish ]
breed [ crawdads crawdad ]
breed [ plants plant ]
breed [ worms worm ]
breed [ droplets droplet ]
breed [ bacterias bacteria ] 

nodes-own [ tank-name ]
droplets-own [ target-node ]
fishes-own [ age current-tank health]
plants-own [ age ]    
crawdads-own [ age ]

to setup
  clear-all
  ask patches [ set pcolor white - 2 ]
  
  set total-fish-harvested 0
  set total-plants-harvested 0
  set current-toxicity 0
  set current-nutrients 50 
  set recent-fish-harvest 0
  set recent-plant-harvest 0
  set fish-yield-rate 0
  set plant-yield-rate 0
  set total-fish-weight 0
  set total-plant-weight 0
  set total-crawdads-harvested 0
  set total-crawdad-weight 0
  set total-fish-deaths 0
  set toxicity-spike-timer 0
  ; --- 1. BUILD THE TANKS & BEDS ---
  make-tank -11  14 8 3 blue  "Duckweed Tank"
  make-tank -11  10 8 3 blue  "Breeding Tank"
  make-tank -11   6 8 3 blue  "Fry Tank"
  make-tank -11   2 8 3 brown "Crawdad Tank 1"
  make-tank -11  -2 8 3 blue  "Fingerling Tank"
  make-tank -11  -6 8 3 blue  "Adult Tank"
  make-tank -11 -10 8 3 brown "Crawdad Tank 2"
  make-tank -11 -14 8 3 gray  "Bio-Filter" ; Fixed position inside the boundaries

  make-tank   0 -10 8 3 green "Grow Bed 1"
  make-tank   0  -5 8 3 green "Grow Bed 2"
  make-tank   0   0 8 3 green "Grow Bed 3"
  make-tank   0   5 8 3 green "Grow Bed 4"
  make-tank   0  10 8 3 green "Grow Bed 5"
  make-tank   0 -14 8 3 cyan  "Holding Tank"

  make-tank  12  10 10 7 brown "Vermaculture"

  ; --- 2. DRAW THE WATER FLOW ARROWS ---
  connect-tanks "Duckweed Tank" "Breeding Tank"
  connect-tanks "Breeding Tank" "Fry Tank"
  connect-tanks "Fry Tank" "Crawdad Tank 1"
  connect-tanks "Crawdad Tank 1" "Fingerling Tank"
  connect-tanks "Fingerling Tank" "Adult Tank"
  connect-tanks "Adult Tank" "Holding Tank"
  connect-tanks "Holding Tank" "Bio-Filter"
  connect-tanks "Bio-Filter" "Duckweed Tank" ; The main return pump line
  
  connect-tanks "Grow Bed 1" "Grow Bed 2"
  connect-tanks "Grow Bed 2" "Grow Bed 3"
  connect-tanks "Grow Bed 3" "Grow Bed 4"
  connect-tanks "Grow Bed 4" "Grow Bed 5"
  connect-tanks "Grow Bed 5" "Duckweed Tank"
  
  connect-tanks "Crawdad Tank 1" "Grow Bed 3" 
  connect-tanks "Adult Tank" "Crawdad Tank 2"
  connect-tanks "Holding Tank" "Crawdad Tank 2"
  connect-tanks "Crawdad Tank 2" "Grow Bed 1"
  
  ; --- 3. POPULATE THE SYSTEM ---
  populate-biology

  reset-ticks
end

to populate-biology
  let initial-threshold get-system-threshold

 let fish-tanks ["Breeding Tank" "Fry Tank" "Fingerling Tank" "Adult Tank" "Holding Tank"]
  foreach fish-tanks [ t-name ->
    ask nodes with [ tank-name = t-name ] [
      hatch-fishes 3 [
        set hidden? false
        set label ""
        set shape "fish"
        ifelse fish-type = "Goldfish" [ set color orange ] [ set color gray + 2 ]
        set health 100
        ; Size them appropriately for their starting tank
        if t-name = "Breeding Tank" [ set size 0.5 ]
        if t-name = "Fry Tank" [ set size 1.0 ]
        if t-name = "Fingerling Tank" [ set size 1.5 ]
        if t-name = "Adult Tank" [ set size 2.0 ]
        if t-name = "Holding Tank" [ set size 2.0 ]
        
        set current-tank t-name
        set age random initial-threshold
        setxy (xcor + random-float 6 - 3) (ycor + random-float 2 - 1)
      ]
    ]
  ]
  
  ask nodes with [ tank-name = "Bio-Filter" ] [
    hatch-bacterias 30 [
      set hidden? false
      set label ""
      set shape "dot"
      set color yellow
      set size 0.8
      setxy (xcor + random-float 6 - 3) (ycor + random-float 2 - 1)
    ]
  ]
  
 ask nodes with [ tank-name = "Crawdad Tank 1" or tank-name = "Crawdad Tank 2" ] [
    hatch-crawdads 3 [
      set hidden? false
      set label ""
      set shape "bug" 
      set color red - 1
      set size 1.5
      set age random initial-threshold ; NEW: Stagger their starting age
      setxy (xcor + random-float 6 - 3) (ycor + random-float 2 - 1)
    ]
  ]
  
  ask nodes with [ tank-name = "Vermaculture" ] [
    hatch-worms 15 [
      set hidden? false
      set label ""
      set shape "line"
      set color orange + 2
      set size 1.5
      setxy (xcor + random-float 8 - 4) (ycor + random-float 6 - 3)
    ]
  ]

  ask nodes with [ substring tank-name 0 8 = "Grow Bed" or tank-name = "Duckweed Tank" ] [
    hatch-plants 6 [
      set hidden? false
      set label ""
      set shape "plant"
      set color green + 2
      set size 2
      set age random initial-threshold
      setxy (xcor + random-float 6 - 3) (ycor + random-float 2 - 1)
    ]
  ]
end

to go
  apply-environmental-chaos
  filter-water
  manage-dynamic-buffers
  
  ; Manage biological lag time
  ifelse current-toxicity > 20 [
    set toxicity-spike-timer toxicity-spike-timer + 1
  ] [
    if toxicity-spike-timer > 0 [ 
      set toxicity-spike-timer toxicity-spike-timer - 1 
    ]
  ]
  ; --- ANIMATE WATER FLOW ---
  ask nodes [
    if random 100 < 15 and any? out-link-neighbors [
      hatch-droplets 1 [
        set hidden? false
        set label ""
        set shape "circle"
        set color cyan
        set size 0.5
        set target-node one-of [out-link-neighbors] of myself
        face target-node
      ]
    ]
  ]
  
  ask droplets [
    fd 0.4
    if distance target-node < 0.5 [ die ]
  ]

  ; --- UNIFIED SYSTEM CYCLE THRESHOLD ---
  let current-threshold get-system-threshold


  ask fishes [
   ; Base organic growth rate
    let growth-rate (0.5 + random-float 1.0)
    
    ; 50% Penalty for unmitigated toxicity
    ifelse current-toxicity > 80 [ 
      set growth-rate (growth-rate * 0.5) 
      set health health - (current-toxicity * 0.005)
    ] [
      if health < 100 [ set health health + 0.5 ]
    ]
    set age age + growth-rate
    
    rt random 60 - 30
    fd 0.1
    if [pcolor] of patch-here != blue and [pcolor] of patch-here != cyan [ rt 180 fd 0.2 ]
    
    
    
    if health <= 0 [
      set total-fish-deaths total-fish-deaths + 1
      log-event (word "MORTALITY: A " fish-type " died in the " current-tank " due to acute toxicity.")
      
      ; Restock a new fish in the breeding tank to maintain the farm's population
      let spawn-node one-of nodes with [ tank-name = "Breeding Tank" ]
      if spawn-node != nobody [
        ask spawn-node [
          hatch-fishes 1 [
            set hidden? false
            set label ""
            set shape "fish"
            ifelse fish-type = "Goldfish" [ set color orange ] [ set color gray + 2 ]
            set size 0.5
            set current-tank "Breeding Tank"
            set age 0
            set health 100 ; Make sure the new fish has full health
            setxy (xcor + random-float 6 - 3) (ycor + random-float 2 - 1)
          ]
        ]
      ]
      die
    ]
    if current-tank = "Holding Tank" and age >= current-threshold [
      set total-fish-harvested total-fish-harvested + 1 
      set recent-fish-harvest recent-fish-harvest + 1
      set total-fish-weight total-fish-weight + get-fish-weight ; NEW
      
      log-event (word "Harvest: Adult fish processed (" get-fish-weight " lbs).") 
      
      let spawn-node one-of nodes with [ tank-name = "Breeding Tank" ]
      if spawn-node != nobody [
        ask spawn-node [
          hatch-fishes 1 [
            set hidden? false
            set label ""
            set shape "fish"
            ifelse fish-type = "Goldfish" [ set color orange ] [ set color gray + 2 ]
            set size 0.5
            set current-tank "Breeding Tank"
            set age 0
            setxy (xcor + random-float 6 - 3) (ycor + random-float 2 - 1)
          ]
        ]
      ]
      die
    ]
    
    if current-tank = "Adult Tank" and age >= current-threshold [
      let dest-node one-of nodes with [ tank-name = "Holding Tank" ]
      if dest-node != nobody [
        move-to dest-node
        set current-tank "Holding Tank"
        set age 0
        setxy (xcor + random-float 6 - 3) (ycor + random-float 2 - 1)
      ]
    ]
    
    if current-tank = "Fingerling Tank" and age >= current-threshold [
      let dest-node one-of nodes with [ tank-name = "Adult Tank" ]
      if dest-node != nobody [
        move-to dest-node
        set current-tank "Adult Tank"
        set size 2.0
        set age 0
        setxy (xcor + random-float 6 - 3) (ycor + random-float 2 - 1)
      ]
    ]
    
    if current-tank = "Fry Tank" and age >= current-threshold [
      let dest-node one-of nodes with [ tank-name = "Fingerling Tank" ]
      if dest-node != nobody [
        move-to dest-node
        set current-tank "Fingerling Tank"
        set size 1.5
        set age 0
        setxy (xcor + random-float 6 - 3) (ycor + random-float 2 - 1)
      ]
    ]
    
    if current-tank = "Breeding Tank" and age >= current-threshold [
      let dest-node one-of nodes with [ tank-name = "Fry Tank" ]
      if dest-node != nobody [
        move-to dest-node
        set current-tank "Fry Tank"
        set size 1.0
        set age 0
        setxy (xcor + random-float 6 - 3) (ycor + random-float 2 - 1)
      ]
    ]
  ]

  ; --- ANIMATE & HARVEST PLANTS ---
  ask plants [
   let growth-rate (0.5 + random-float 1.0)
    
    ; 50% Penalty for starvation
    if current-nutrients < 30 [ 
      set growth-rate (growth-rate * 0.5) 
    ]
    set age age + growth-rate
    
    if age >= current-threshold [
      set total-plants-harvested total-plants-harvested + 1 
      set recent-plant-harvest recent-plant-harvest + 1
      set total-plant-weight total-plant-weight + get-plant-weight ; NEW
      
      log-event (word "Harvest: " plant-type " matured and harvested (" get-plant-weight " lbs).")
      set age 0
      set color green + 3 
    ]
    
    if color > (green + 2) [ set color color - 0.1 ]
  ]
  
  ; --- ANIMATE OTHER ANIMALS ---
 ask bacterias [
    rt random 90 - 45
    fd 0.05
    if [pcolor] of patch-here = (white - 2) [ rt 180 fd 0.1 ]

    ; Bacteria reproduce when toxicity provides plentiful food
    if current-toxicity > 20 and random 100 < 5 [
      hatch 1 [ rt random 360 ]
    ]
    
    ; Bacteria die off if starved, preserving a baseline colony of 30
    if current-toxicity = 0 and count bacterias > 30 and random 100 < 2 [
      die
    ]
  ]

  ask crawdads [
    ; Crawdads grow over time
    set age age + (0.5 + random-float 1.0)
    
    rt random 60 - 30
    fd 0.05
    if [pcolor] of patch-here != brown [ rt 180 fd 0.1 ]
    
    ; Harvest logic
    if age >= current-threshold [
      set total-crawdads-harvested total-crawdads-harvested + 1
      
      ; Assume an average adult crawdad yields 0.15 lbs
      set total-crawdad-weight total-crawdad-weight + 0.15 
      
      log-event "Harvest: Crawdad trapped and harvested (0.15 lbs)."
      
      ; Reset age and size to simulate a new juvenile replacing the harvested adult
      set age 0
      set size 0.8
    ]
    
    ; Visually grow the juvenile back to adult size over time
    if size < 1.5 [
      set size size + 0.01
    ]
  ]
  
  ask worms [if not hidden? [
      rt random 90 - 45
      fd 0.02
      
      ; Worms reproduce/create harvestable compost over time
      ; Worms reproduce/create harvestable compost over time
      if random 1000 < 5 [
        set total-vermaculture-harvested total-vermaculture-harvested + 1
        log-event "Harvest: Vermicompost collected." ; NEW HARVEST LOG
      ]
    ]
  ]

  ; --- CALCULATE ROLLING RATES ---
  if ticks mod 100 = 0 and ticks > 0 [
    set fish-yield-rate recent-fish-harvest
    set plant-yield-rate recent-plant-harvest
    set recent-fish-harvest 0
    set recent-plant-harvest 0
  ]

  tick
end


to apply-environmental-chaos
  if random 1000 < shock-probability [
    log-event "SHOCK: Bio-filter pump failure! Toxicity spikes."
    set current-toxicity current-toxicity + 150
  ]
  if random 1000 < shock-probability [
    log-event "SHOCK: Temperature crash! Plant nutrient uptake stalled."
    set current-nutrients 0
  ]
  ; BIOLOAD MATH: Scale excretion by size AND add a +/- 20% metabolic variance
  set current-fish-bio-load sum [ get-n-excretion * (size / 2.0) * (0.8 + random-float 0.4) ] of fishes
  
  ; Apply the same variance to crawdads individually
  let crawdad-bio-load sum [ 13.0 * (0.8 + random-float 0.4) ] of crawdads
  
  let total-raw-excretion (current-fish-bio-load + crawdad-bio-load)
  
  ; Convert raw ug/N/h to NetLogo toxicity units
  set current-toxicity current-toxicity + (total-raw-excretion * 0.001)
end

to filter-water
  let active-bacteria count bacterias
  
  ; NEW: Reads the bacteria-efficiency slider
  let conversion-rate active-bacteria * bacteria-efficiency * (0.9 + random-float 0.2)
  
  if current-toxicity > 0 [
    let converted-amount min list current-toxicity conversion-rate
    set current-toxicity current-toxicity - converted-amount
    set current-nutrients current-nutrients + converted-amount
  ]
  if current-toxicity < 0 [ set current-toxicity 0 ] 
  
  let threshold get-system-threshold
  set current-plant-uptake sum [ (0.5 + (age / threshold) / 2) * get-plant-n-uptake * (0.8 + random-float 0.4) ] of plants
  
  if current-nutrients > 0 [
    ; NEW: Reads the plant-uptake-multiplier slider
    set current-nutrients current-nutrients - (current-plant-uptake * plant-uptake-multiplier)
  ]
  if current-nutrients < 0 [ set current-nutrients 0 ] 
end
to manage-dynamic-buffers
  if current-toxicity > 50 [
    ask nodes with [ tank-name = "Duckweed Tank" ] [
      ; FIX 3: Cap the buffer plants so they don't infinitely multiply
      if count plants in-radius 5 < 30 [
        hatch-plants 1 [
          set hidden? false
          set label ""
          set shape "plant"
          set color green + 2
          set size 1.5
          set age 0
          setxy (xcor + random-float 6 - 3) (ycor + random-float 2 - 1)
        ]
      ]
    ]
    set current-toxicity current-toxicity - 5 
  ]
end
to manage-vermaculture-state
  ; Define which plants create enough waste to feed the worms
  let waste-producers ["Tomatoes" "Swiss Chard"] 
  let is-active member? plant-type waste-producers
  
  ; Toggle worm visibility and activity
  ask worms [ set hidden? not is-active ]
  
  ; Toggle the visual tank background (cx=12, cy=10, w=10, h=7)
  ask patches with [
    pxcor >= 7 and pxcor <= 17 and pycor >= 6.5 and pycor <= 13.5
  ] [
    ifelse is-active [ set pcolor brown ] [ set pcolor white - 2 ]
  ]
  
  ; Ensure the label toggles correctly
  ask patch 12 10 [
    ifelse is-active [ set plabel "Vermaculture" ] [ set plabel "" ]
  ]
end
; --- UNIFIED THRESHOLD FUNCTION ---
to-report get-system-threshold
  let base-threshold 30
  
  ; The heartbeat of the entire system is dictated by the plant type
  if plant-type = "Watercress"           [ set base-threshold 20 ]
  if plant-type = "Lettuce"              [ set base-threshold 25 ] 
  if plant-type = "Swiss Chard"          [ set base-threshold 30 ]
  if plant-type = "Basil"                [ set base-threshold 30 ]
  if plant-type = "Mint"                 [ set base-threshold 40 ]
  if plant-type = "Tomatoes"             [ set base-threshold 60 ]
  
  ; ENVIRONMENTAL PENALTY: High toxicity or low nutrients slows the whole cycle down
  if current-toxicity > 80 or current-nutrients < 30 [
    report base-threshold * 1.5
  ]
  
  report base-threshold
end

; --- HELPER FUNCTIONS ---

to make-tank [ cx cy w h bcolor bname ]
  ask patches with [
    pxcor >= cx - (w / 2) and pxcor <= cx + (w / 2) and
    pycor >= cy - (h / 2) and pycor <= cy + (h / 2)
  ] [ set pcolor bcolor ]
  
  create-nodes 1 [
    setxy cx cy
    set hidden? true
    set tank-name bname
  ]
  
  ask patch cx cy [
    set plabel bname
    set plabel-color black
  ]
end

to connect-tanks [ from-name to-name ]
  let source one-of nodes with [ tank-name = from-name ]
  let target one-of nodes with [ tank-name = to-name ]
  if source != nobody and target != nobody [
    ask source [
      create-link-to target [
        set color black
        set thickness 0.2
      ]
    ]
  ]
end

; --- REAL DATA: NITROGEN EXCRETION ---
to-report get-n-excretion
  ; Real-world mean Nitrogen excretion rates (ug N/ind/h) 
  if fish-type = "Crayfish"        [ report 13.0 ]
  if fish-type = "Tilapia"         [ report 132.0 ]
  if fish-type = "Channel Catfish" [ report 343.1 ] 
  if fish-type = "Goldfish"        [ report 1508.7 ]
  if fish-type = "Trout"           [ report 1609.5 ]
  
  report 100.0 ; Default fallback for new species
end

; --- REAL DATA: NUTRIENT ABSORPTION ---
to-report get-plant-n-uptake
  ; Scaled up to biologically balance the high ug N/h excretion from the fish
  if plant-type = "Watercress"  [ report 1200 ]
  if plant-type = "Lettuce"     [ report 800 ] 
  if plant-type = "Swiss Chard" [ report 1000 ]
  if plant-type = "Basil"       [ report 900 ]
  if plant-type = "Mint"        [ report 1100 ]
  if plant-type = "Tomatoes"    [ report 2000 ] 
  
  report 1000
end
to log-event [ msg ]
  output-print (word "[Tick " ticks "] " msg)
end

to-report get-fish-weight
  if fish-type = "Tilapia" [ report 1.5 ] 
  if fish-type = "Channel Catfish" [ report 2.0 ]
  if fish-type = "Trout" [ report 1.2 ]
  if fish-type = "Goldfish" [ report 0.2 ]
  report 1.0
end

to-report get-plant-weight
  if plant-type = "Tomatoes" [ report 2.5 ]
  if plant-type = "Swiss Chard" [ report 1.0 ]
  if plant-type = "Lettuce" [ report 0.5 ]
  if plant-type = "Watercress" [ report 0.4 ]
  if plant-type = "Mint" [ report 0.3 ]
  if plant-type = "Basil" [ report 0.2 ]
  report 0.5
end]]></code>
  <widgets>
    <view x="310" wrappingAllowedX="true" y="15" frameRate="30.0" minPycor="-16" height="719" showTickCounter="true" patchSize="21.67" fontSize="15" wrappingAllowedY="true" width="719" tickCounterLabel="ticks" maxPycor="16" updateMode="0" maxPxcor="16" minPxcor="-16"></view>
    <plot x="1405" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Absorption" y="210" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="230" xAxis="ticks" display="Plant Nitrate Uptake">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Crop Uptake" color="-13840069" legend="true">
        <setup></setup>
        <update>plot current-plant-uptake</update>
      </pen>
    </plot>
    <plot x="1635" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="weights" y="210" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="230" xAxis="ticks " display="Harvest Weights (Aquatics)">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Fish (lbs)" color="-11033397" legend="true">
        <setup></setup>
        <update>plot total-fish-weight </update>
      </pen>
    </plot>
    <output x="1045" y="400" height="180" fontSize="26" width="400"></output>
    <plot x="1455" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Colony Population" y="405" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="230" xAxis="ticks" display="Bacteria Count">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Population" color="-1184463" legend="true">
        <setup></setup>
        <update>plot count bacterias</update>
      </pen>
    </plot>
    <plot x="1685" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Weights ( lbs ) " y="405" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="230" xAxis="ticks" display="Harvest Weights (Plants)">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Plant Weights" color="-8732573" legend="true">
        <setup></setup>
        <update>plot total-plant-weight</update>
      </pen>
    </plot>
    <plot x="1455" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Weight (lb)" y="585" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="230" xAxis="ticks" display="Harvest Weight (Vermaculture)">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Vermicompost (lbs)" color="-5207188" legend="true">
        <setup></setup>
        <update>plot total-vermaculture-harvested

</update>
      </pen>
    </plot>
    <plot x="1690" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="weight" y="585" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="230" xAxis="ticks" display="Harvested Crawdad Weight">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Crawdad Weight (lb)" color="-2674135" legend="true">
        <setup></setup>
        <update>plot total-crawdad-weight
</update>
      </pen>
    </plot>
    <chooser x="1230" y="215" height="60" variable="plant-type" current="2" width="155" display="plant-type">
      <choice type="string" value="Lettuce"></choice>
      <choice type="string" value="Basil"></choice>
      <choice type="string" value="Tomatoes"></choice>
      <choice type="string" value="Mint"></choice>
    </chooser>
    <chooser x="1050" y="215" height="60" variable="fish-type" current="3" width="155" display="fish-type">
      <choice type="string" value="Tilapia"></choice>
      <choice type="string" value="Channel Catfish"></choice>
      <choice type="string" value="Trout"></choice>
      <choice type="string" value="Goldfish"></choice>
    </chooser>
    <slider x="1050" step="1" y="280" max="100" width="155" display="nutrient-per-day" height="60" min="0" direction="Horizontal" default="100.0" variable="nutrient-per-day"></slider>
    <slider x="1055" step=".0001" y="345" max=".005" width="150" display="plant-uptake-multiplier" height="50" min="0.0001" direction="Horizontal" default="0.005" variable="plant-uptake-multiplier"></slider>
    <plot x="1040" autoPlotX="true" yMax="10.0" autoPlotY="true" y="15" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="230" display="Harvest">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Fish" color="-13345367" legend="true">
        <setup></setup>
        <update>plot total-fish-harvested</update>
